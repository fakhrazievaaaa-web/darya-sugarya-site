---
import { site } from '@/data/site';

interface Crumb { label: string; href: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: new URL(item.href, `https://${site.domain}`).toString(),
  })),
};
---
<nav aria-label="Хлебные крошки" class="breadcrumbs">
  <ol>
    {items.map((item, i) => (
      <li>
        {i < items.length - 1
          ? <a href={item.href}>{item.label}</a>
          : <span aria-current="page">{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .breadcrumbs { padding: 14px 0 0; }
  .breadcrumbs ol {
    display: flex; flex-wrap: wrap; gap: 6px;
    list-style: none; padding: 0; margin: 0;
    font-size: 0.85rem; color: var(--color-text-soft);
  }
  .breadcrumbs li:not(:last-child)::after { content: '/'; margin-left: 6px; }
  .breadcrumbs a { color: var(--color-text-soft); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--color-berry); }
</style>
