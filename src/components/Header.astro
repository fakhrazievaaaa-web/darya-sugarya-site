---
import { site, analyticsGoals } from '@/data/site';

const nav = [
  { href: '/lazernaya-epilyatsiya-taganskaya/', label: 'Лазер' },
  { href: '/shugaring-taganskaya/', label: 'Шугаринг' },
  { href: '/voskovaya-depilyatsiya-taganskaya/', label: 'Воск' },
  { href: '/prices/', label: 'Цены' },
  { href: '/kak-vybrat-metod/', label: 'Как выбрать' },
  { href: '/about/', label: 'О студии' },
  { href: '/blog/', label: 'Статьи' },
  { href: '/contacts/', label: 'Контакты' },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo">Дарья Шугарья</a>

    <input type="checkbox" id="nav-toggle" class="site-header__toggle-input" />
    <label for="nav-toggle" class="site-header__toggle" aria-label="Открыть меню">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-header__nav" aria-label="Основное меню">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={site.phoneHref} class="site-header__phone" data-goal={analyticsGoals.phone}>{site.phone}</a>
      <a
        href={site.yclientsBaseUrl}
        class="btn btn--primary btn--sm"
        target="_blank" rel="noopener"
        data-goal={analyticsGoals.bookingHeader}
      >Записаться</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(241, 244, 238, 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--color-line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .site-header__logo {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__nav ul {
    display: flex;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .site-header__nav a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 500;
  }
  .site-header__nav a:hover { color: var(--color-berry); }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .site-header__phone {
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text);
    white-space: nowrap;
  }
  .site-header__toggle-input { display: none; }
  .site-header__toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
    padding: 6px;
  }
  .site-header__toggle span {
    width: 22px; height: 2px; background: var(--color-text);
  }

  @media (max-width: 860px) {
    .site-header__nav {
      position: absolute;
      top: 100%; left: 0; right: 0;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-line);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }
    .site-header__nav ul { flex-direction: column; padding: 16px 20px; gap: 14px; }
    .site-header__toggle { display: flex; }
    .site-header__toggle-input:checked ~ .site-header__nav { max-height: 480px; }
    .site-header__phone { display: none; }
  }
</style>
