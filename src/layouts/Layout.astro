---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileCta from '@/components/MobileCta.astro';
import { site } from '@/data/site';

interface Props {
  title: string;
  description: string;
  path: string; // например: "/lazernaya-epilyatsiya-taganskaya/"
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, path, ogImage = '/images/og-cover.jpg', noindex = false } = Astro.props;
const canonicalUrl = new URL(path, `https://${site.domain}`).toString();
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={new URL(ogImage, `https://${site.domain}`).toString()} />
  <meta property="og:locale" content="ru_RU" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- Яндекс.Метрика: вставьте счётчик после получения ID, см. README -->
  <!-- <script>
    (function(m,e,t,r,i,k,a){...})(window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
    ym({site.yandexMetrikaId}, "init", { clickmap:true, trackLinks:true, accurateTrackBounce:true });
  </script> -->

  <slot name="head" />
</head>
<body>
  <a href="#main" class="visually-hidden">Перейти к содержанию</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <MobileCta />
</body>
</html>
